# Copy this file to .env (which is gitignored) and fill in as needed.
# Nothing here is required to run `npm run dev` or `npm run verify` — the app
# degrades gracefully without services.

# --- Local full-stack run -----------------------------------------------------
# Provided automatically by `npm run preview:local` and `npm run verify:fullstack`.
# Set these only if you point the app at your own Postgres/Redis.
# DATABASE_URL=postgres://billing:billing@127.0.0.1:5432/billing_preview
# REDIS_URL=redis://127.0.0.1:6379

# Fake signing secret used to demonstrate webhook signature validation.
# Any value works; it is intentionally NOT a real provider secret.
# DEMO_WEBHOOK_SECRET=whsec_preview_demo_do_not_use_in_production

# --- Daytona live PR previews -------------------------------------------------
# Only needed to run the Python helper against the real Daytona API from your
# machine. In CI this is the repository secret DAYTONA_API_KEY — never commit a
# real key (this file is an example; the real .env is gitignored).
# DAYTONA_API_KEY=dtn_your_key_here
# DAYTONA_ORGANIZATION_ID=
